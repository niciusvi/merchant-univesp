# Copie para ".env" (ignorado pelo git) e preencha. NUNCA commite o .env.
# No Portainer, cadastre as mesmas variáveis na tela da stack (Environment variables).

# Chave do Django. Gere com:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Com DJANGO_DEBUG=0 este valor de exemplo é recusado de propósito.
DJANGO_SECRET_KEY=TROQUE-ESTE-VALOR

# 1 só na sua máquina. Em produção 0: páginas de erro genéricas e cookies apenas por HTTPS.
DJANGO_DEBUG=1

# Hosts aceitos, separados por vírgula. 127.0.0.1 entra sempre (healthcheck do contêiner).
# Produção: o domínio público, sem https://.
DJANGO_ALLOWED_HOSTS=localhost

# Origens autorizadas a enviar formulários, COM https:// e separadas por vírgula.
# Produção: https://SEU-DOMINIO. Local pode ficar vazio.
DJANGO_CSRF_TRUSTED_ORIGINS=

# 1 quando a app fica atrás de túnel/proxy que termina o HTTPS (Cloudflare, nginx).
DJANGO_ATRAS_DE_PROXY=0

# Caminho do banco SQLite. Local: db.sqlite3. No contêiner a imagem já define /data/db.sqlite3.
DJANGO_DB_PATH=db.sqlite3

# Admin criado na primeira subida se os três estiverem preenchidos.
# Se o usuário já existir nada acontece; depois da primeira subida pode apagar os valores.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# ---- Só para a stack do Portainer (docker-compose.yml) ----
# Porta publicada no servidor; aponte o túnel/proxy para ela.
MERCADO_PORTA=8080
# Etiqueta da imagem no GHCR: nome da branch (ex.: feat-painel-vencimentos), sha-<commit> ou latest (main).
IMAGEM_TAG=latest
# Conta do GitHub que publicou as imagens (dono do repositório onde o Actions rodou).
DONO_DAS_IMAGENS=niciusvi
# Processos do gunicorn. 2 bastam para um mercado pequeno.
GUNICORN_WORKERS=2
TZ=America/Sao_Paulo
